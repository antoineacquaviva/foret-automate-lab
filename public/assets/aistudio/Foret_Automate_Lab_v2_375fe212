# - break_rule_id (1), break_penalty_id (1)
# - momentum_rule_id (1)
# - doubles_rule_id (1)
# - scoring_mode_id (1), regen_max_per_cell (1)
# Total Header = 10 ints

# Topologies & Biomes:
# Up to J_max = 6 tracks, L_max = 8 cells:
# - init_cells[6, 8] = 48 ints (if symmetric across tracks, 8 ints; let's allow per-biome profile up to 4 profiles * 8 = 32 ints, or 8 ints base + biome_mode + obstacle_mask[8] + cell_weights[8] = 25 ints)
# Let's count precisely:
# - cell_cap[8] (8)
# - cell_weights[8] (8)
# - obstacle_mask[8] (8)
# - biome_asymmetry_mode (1)
# Total Arena = 25 ints

# Tactics: N_max = 6 tactics, M_max = 4 slots per tactic
# Per tactic header: machine_type (1), wave_mode (1), sort_criterion (1), fallback_mode (1) = 4 ints
# Per slot (12 fields):
#   cond1_sensor, cond1_op, cond1_val,
#   logic_op (NONE/AND/OR),
#   cond2_sensor, cond2_op, cond2_val,
#   act_true_verb, act_true_qty, act_true_offset,
#   act_false_verb, act_false_qty, act_false_offset,
#   parry_mode, parry_cost = 15 ints
# So 1 tactic = 4 + 4 * 15 = 64 ints
# 6 tactics = 6 * 64 = 384 ints

# Learning Track (11 cells + rules):
# - init_track[11] (11)
# - init_tile_side[11] (11) # for recto-verso flip
# - eval_trigger_mode (1), threshold_val (1), shift_step_pos (1), shift_step_neg (1), on_cell_cleared_rule (1), geom_move_mode (1) = 6 ints
# Total Learning = 28 ints

total_genome_ints = 10 + 25 + 384 + 28
genome_bytes = total_genome_ints * 4
print(f"Total genome ints: {total_genome_ints} int32 ({genome_bytes} bytes)")

# 2. Multi-fidelity Successive Halving budget calculation
# Full eval without multi-fidelity: 1000 games * 7 bots * 4 player counts * 3 effort rates = 84,000 games per variant
games_per_var_full = 1000 * 7 * 4 * 3
# With 3-rung Successive Halving (Rung 1: 100% of pop, 80 games * 4 bots * 1 table * 1 effort = 320 games;
# Rung 2: top 25% of pop, 400 games * 7 bots * 2 tables * 2 efforts = 11,200 games;
# Rung 3: top 5% of pop, 1000 games * 7 bots * 4 tables * 3 efforts = 84,000 games)
rung1_games = 80 * 4 * 1 * 1
rung2_games = 400 * 7 * 2 * 2
rung3_games = 1000 * 7 * 4 * 3
avg_games_per_var_sh = 1.0 * rung1_games + 0.25 * rung2_games + 0.05 * rung3_games
speedup_factor = games_per_var_full / avg_games_per_var_sh
print(f"Full games/var: {games_per_var_full:,} | Avg SH games/var: {avg_games_per_var_sh:,.0f} | Speedup: {speedup_factor:.2f}x")

# 3. Shannon Entropy max for 3 states (Arbres, Souches redressées, Terrassés)
h_max = np.log2(3)
# Example for balanced target (65% trees, 15% regenerated stumps, 20% terraced)
p = np.array([0.65, 0.15, 0.20])
h_target = -np.sum(p * np.log2(p))
print(f"H_max (3 states): {h_max:.4f} bits | H_target (65/15/20): {h_target:.4f} bits ({h_target/h_max*100:.1f}% of max)")

# 4. MAP-Elites grid size: e.g., 10 x 10 x 8 = 800 niches
niches = 10 * 10 * 8
print(f"MAP-Elites archive size: {niches} niches")


